    "ejs": "3.1.10",
    "errorhandler": "1.4.3",
    "express": "4.22.2",
    "express-ejs-layouts": "^2.5.1",
    "express-fileupload": "1.5.1",
    "express-session": "^1.17.2",
    "file-type": "^8.1.0",
    "hbs": "^4.2.1",
    "humanize-ms": "1.2.1",
    "jquery": "^3.5.0",
    "lodash": "4.18.1",
    "marked": "4.0.10",
    "method-override": "latest",
    "moment": "2.29.4",
